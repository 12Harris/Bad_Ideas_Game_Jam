; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game_Jam_Template"
run/main_scene="uid://blioonruu4ho8"
config/features=PackedStringArray("4.6")
config/icon="res://assets/icon.svg"

[autoload]

Game_Manager="*uid://df1ox35rp72hr"
UI_Manager="*uid://c4uwr1nywqsl1"
G_Inventory="*uid://dt8mhip0sdnm6"
G_Utils="*uid://crlkh6xwd8rna"
Main_Camera="*uid://dtyjfldcj6d2w"
Global_Sounds="*uid://criq6hl3uw4v4"

[display]

window/size/viewport_width=1919
window/size/viewport_height=1079
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[editor]

export/convert_text_resources_to_binary=false

[filesystem]

import/blender/enabled=false

